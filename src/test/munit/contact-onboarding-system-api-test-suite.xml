    <!-- ========================================================= -->
    <!-- Test 1: Update an existing Contact                        -->
    <!-- ========================================================= -->

    <munit:test
        name="testDatabaseUpdate"
        description="Update an existing Contact record">

        <munit:behavior>

            <munit-tools:mock-when processor="db:select">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Check Existing Contact']"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>
                    <munit-tools:payload
                        value='#[[
                            {
                                contact_sf_id: "003TEST"
                            }
                        ]]'
                        mediaType="application/java"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <munit-tools:mock-when processor="db:update">
                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[1]"
                        mediaType="application/java"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Existing Contact Payload">

                <munit:payload
                    value='#[{
                        contact_sf_id: "003TEST",
                        first_name: "Priya",
                        last_name: "Adhikari",
                        email: "priya.adhikari@test.com",
                        phone: "9876543210",
                        account_id: "001TEST",
                        job_title: "Technical Trainee",
                        department: "Technology",
                        reports_to_id: null,
                        reports_to_name: "Unassigned",
                        account_name: "Microsoft",
                        account_industry: "Technology",
                        account_type: "Customer - Direct",
                        account_revenue: 15000000,
                        account_contact_count: 4,
                        contact_priority: "HIGH",
                        modified_date: "2026-10-11 10:33:15"
                    }]'
                    mediaType="application/java"/>

                <munit:variables>
                    <munit:variable
                        key="messageContext"
                        value='#[{
                            correlationId: "TEST-CORRELATION-UPDATE",
                            contactId: "003TEST"
                        }]'
                        mediaType="application/java"/>
                </munit:variables>

            </munit:set-event>

            <flow-ref
                name="contact-database-upsert-subflow"
                doc:name="Execute Database Update"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:verify-call
                processor="db:select"
                times="1"/>

            <munit-tools:verify-call
                processor="db:update"
                times="1"/>

            <munit-tools:verify-call
                processor="db:insert"
                times="0"/>

        </munit:validation>

    </munit:test>

