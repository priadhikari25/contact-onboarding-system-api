    <!-- ========================================================= -->
    <!-- Test 3: Missing Account ID stored in failure table         -->
    <!-- ========================================================= -->

    <munit:test
        name="testMissingAccountIdStoresFailure"
        description="Store missing Account ID validation failure and reject the RabbitMQ message">

        <munit:behavior>

            <munit-tools:mock-when processor="db:insert">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Store Contact Onboarding Failure']"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[1]"
                        mediaType="application/java"/>
                </munit-tools:then-return>

            </munit-tools:mock-when>

            <munit-tools:mock-when processor="amqp:reject">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Reject Invalid Message Without Requeue']"/>
                </munit-tools:with-attributes>

            </munit-tools:mock-when>

            <munit-tools:mock-when processor="amqp:ack">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Acknowledge RabbitMQ Message']"/>
                </munit-tools:with-attributes>

            </munit-tools:mock-when>

        </munit:behavior>

        <munit:execution>

            <munit:set-event doc:name="Set Message Missing Account ID">

                <munit:payload
                    value='#[{
                        contact_sf_id: "003MISSINGACCOUNT",
                        first_name: "Priya",
                        last_name: "Adhikari",
                        email: "priya.adhikari@test.com",
                        phone: "9876543210",
                        account_id: null,
                        job_title: "Technical Trainee",
                        department: "Technology",
                        reports_to_id: null,
                        reports_to_name: "Unassigned",
                        account_name: "Unknown",
                        account_industry: null,
                        account_type: null,
                        account_revenue: null,
                        account_contact_count: 0,
                        contact_priority: "NORMAL",
                        modified_date: "2026-10-12 13:00:00"
                    }]'
                    mediaType="application/java"/>

                <munit:attributes
                    value='#[{
                        ackId: "ACK-MISSING-ACCOUNT"
                    }]'
                    mediaType="application/java"/>

            </munit:set-event>

            <flow-ref
                name="contact-onboarding-message-consumer-flow"
                doc:name="Execute Missing Account Failure Path"/>

        </munit:execution>

        <munit:validation>

            <munit-tools:assert-that
                expression="#[vars.messageContext.contactId]"
                is="#[MunitTools::equalTo('003MISSINGACCOUNT')]"
                message="Contact ID was not preserved."/>

            <munit-tools:assert-that
                expression="#[vars.messageContext.failureRecord.errorMessage]"
                is="#[MunitTools::equalTo('Account Identifier is missing.')]"
                message="Incorrect missing Account ID error message."/>

            <munit-tools:assert-that
                expression="#[vars.messageContext.failureRecord.correlationId]"
                is="#[MunitTools::notNullValue()]"
                message="Correlation ID was not stored."/>

            <munit-tools:assert-that
                expression="#[vars.messageContext.failureRecord.originalPayload]"
                is="#[MunitTools::containsString('003MISSINGACCOUNT')]"
                message="Original message was not preserved."/>

            <munit-tools:verify-call
                processor="db:insert"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Store Contact Onboarding Failure']"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

            <munit-tools:verify-call
                processor="amqp:reject"
                times="1">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Reject Invalid Message Without Requeue']"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

            <munit-tools:verify-call
                processor="amqp:ack"
                times="0">

                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Acknowledge RabbitMQ Message']"/>
                </munit-tools:with-attributes>

            </munit-tools:verify-call>

        </munit:validation>

    </munit:test>

